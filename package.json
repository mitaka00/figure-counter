{
  "name": "figure-counter",
  "version": "1.0.0",
  "description": "Counts contiguous figures (4-connected groups of marked cells) in a 2D matrix. Zero dependencies, works in Node.js and browsers.",
  "license": "MIT",
  "author": "Dimitar Dimitrov",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist coverage",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.lib.json && tsc -p tsconfig.json",
    "bench": "tsx bench/bench.ts",
    "check:package": "publint && attw --pack .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build && npm run smoke && npm run check:package",
    "prepublishOnly": "npm run verify",
    "smoke": "node scripts/smoke-test.cjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.24.0",
    "@types/jest": "^29.5.14",
    "eslint": "^9.24.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "publint": "^0.3.12",
    "ts-jest": "^29.3.2",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1"
  }
}
